# Client-side Firebase Config (Public & 100% Free Tier)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Server-side Firebase Admin Service Account (Secret)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 100% Free APK Hosting via GitHub Releases Asset URL
BETA_APK_DOWNLOAD_URL=https://github.com/YOUR_USERNAME/actiquest/releases/download/v1.2.0/ActiQuest-Beta-v1.2.0.apk

# Whitelisted Approved Testers Only (Comma-separated emails you approve)
APPROVED_BETA_TESTERS_EMAILS=student1@dlsl.edu.ph,student2@ust.edu.ph,reviewer@school.edu.ph
